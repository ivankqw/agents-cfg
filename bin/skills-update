#!/usr/bin/env bash
# Update third-party skills, then immediately restore this repo's safety metadata.
set -euo pipefail

SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
  TARGET="$(readlink "$SCRIPT")"
  case "$TARGET" in
    /*) SCRIPT="$TARGET" ;;
    *) SCRIPT="$DIR/$TARGET" ;;
  esac
done
AC="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
SHARED_SKILLS="${SHARED_SKILLS:-$HOME/.agents/skills}"
DISABLED_SKILLS="${DISABLED_SKILLS:-$HOME/.agents/skills-disabled}"

mkdir -p "$SHARED_SKILLS" "$DISABLED_SKILLS"
chmod 700 "$SHARED_SKILLS" "$DISABLED_SKILLS"

resolve_for_compare() { # resolve_for_compare <path>
  DIR="$(cd "$(dirname "$1")" && pwd -P)"
  printf '%s/%s\n' "$DIR" "$(basename "$1")"
}

LOCK="$HOME/skills-lock.json"
DESIRED_LOCK="$(resolve_for_compare "$AC/skills-lock.json")"
if [ -L "$LOCK" ]; then
  TARGET="$(readlink "$LOCK")"
  case "$TARGET" in
    /*) TARGET_PATH="$TARGET" ;;
    *) TARGET_PATH="$(dirname "$LOCK")/$TARGET" ;;
  esac
  CURRENT_LOCK="$(resolve_for_compare "$TARGET_PATH")"
  if [ "$CURRENT_LOCK" != "$DESIRED_LOCK" ]; then
    echo "refusing to retarget skills lock symlink: $LOCK -> $TARGET" >&2
    exit 1
  fi
  ln -sfn "$AC/skills-lock.json" "$LOCK"
elif [ ! -e "$LOCK" ]; then
  ln -sfn "$AC/skills-lock.json" "$LOCK"
else
  echo "refusing to replace non-symlink skills lock: $LOCK" >&2
  exit 1
fi

( cd "$HOME" && npx skills update )

python3 "$AC/scripts/skill_metadata.py" migrate-ponytail-quarantine "$SHARED_SKILLS" "$DISABLED_SKILLS"
python3 "$AC/scripts/skill_metadata.py" install-ponytail \
  "$AC/skills/ponytail" "$SHARED_SKILLS/ponytail" "$DISABLED_SKILLS"
python3 "$AC/scripts/skill_metadata.py" apply "$SHARED_SKILLS"
python3 "$AC/scripts/skill_metadata.py" check "$SHARED_SKILLS"
python3 "$AC/scripts/skill_metadata.py" unlock "$AC/skills-unlock.txt" "$SHARED_SKILLS"
