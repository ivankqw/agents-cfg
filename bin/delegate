#!/usr/bin/env bash
# delegate — route adversarial review / rescue work to Codex while it has credit,
# and hand it to the in-harness `reviewer` agent when it does not.
#
# Codex exposes no quota API, and a spend-capped run is only distinguishable by
# its stderr text. So the real invocation IS the probe: we always attempt Codex
# unless a recent cap is still cached, and we treat ANY failure as "fall back".
# Only a cap match writes the memo — a network blip must not silence Codex.
#
#   delegate review <base-ref>     review the diff since <base-ref>
#   delegate rescue "<question>"   ask Codex to investigate
#   delegate status                show routing state
#   delegate cap-clear             forget a cached cap (owner raised it mid-cycle)
#
# Exit: 0 = Codex produced output   3 = caller should dispatch `reviewer`   1 = usage

set -uo pipefail

MEMO="${HOME}/.claude/codex-availability.json"
LOG="${HOME}/.claude/codex-availability.log"
TTL=$((24 * 60 * 60))          # cap cache lifetime; short so a mid-cycle raise self-heals
CAP_RE='spend cap'

now()  { date +%s; }
stamp(){ date +%Y-%m-%dT%H:%M:%S%z; }  # portable: BSD date has no -Iseconds
note() { printf '%s\n' "$*" >&2; }
record(){ printf '%s path=%s reason=%s\n' "$(stamp)" "$1" "$2" >> "$LOG"; }

memo_epoch() {
  [ -f "$MEMO" ] || { echo 0; return; }
  local n; n=$(grep -o '[0-9][0-9]*' "$MEMO" 2>/dev/null | head -1)
  echo "${n:-0}"
}

cap_is_fresh() {
  local at age; at=$(memo_epoch); [ "$at" -gt 0 ] || return 1
  age=$(( $(now) - at ))
  [ "$age" -ge 0 ] && [ "$age" -lt "$TTL" ]
}

write_memo() {
  local tmp; tmp=$(mktemp "${MEMO}.XXXXXX") || return 0
  printf '{"capped_at_epoch":%s,"capped_at":"%s"}\n' "$(now)" "$(stamp)" > "$tmp"
  mv -f "$tmp" "$MEMO"
}

fallback() {   # $1 = reason class, $2 = task description for the reviewer
  record claude "$1"
  note ""
  note "Codex unavailable ($1). Do NOT retry Codex."
  note "Dispatch the reviewer as a NEW agent with no memory of this session on: $2"
  note "Give it the repo path, the command that shows the diff, and what the change claims to do."
  exit 3
}

run_codex() {  # $1 = reason class for logging, $2 = prompt, $3 = task description
  local out err rc
  out=$(mktemp); err=$(mktemp)
  codex exec --skip-git-repo-check -o "$out" "$2" >/dev/null 2>"$err" </dev/null
  rc=$?
  # Success is positive: clean exit AND actual content. Never "absence of an error string".
  if [ "$rc" -eq 0 ] && [ -s "$out" ]; then
    record codex ok
    cat "$out"; rm -f "$out" "$err"; return 0
  fi
  local clean; clean=$(sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$err" 2>/dev/null)
  if printf '%s' "$clean" | grep -qi "$CAP_RE"; then
    write_memo
    printf '%s cap-detected: %s\n' "$(stamp)" "$(printf '%s' "$clean" | tail -2 | tr '\n' ' ')" >> "$LOG"
    rm -f "$out" "$err"; fallback "cap" "$3"
  fi
  printf '%s codex-failure(rc=%s): %s\n' "$(stamp)" "$rc" "$(printf '%s' "$clean" | tail -2 | tr '\n' ' ')" >> "$LOG"
  rm -f "$out" "$err"
  fallback "transient rc=$rc" "$3"   # transient failures fall back but never memo
}

case "${1:-}" in
  review)
    base="${2:-origin/main}"
    # Pin and validate the range BEFORE spending a Codex call or a reviewer dispatch:
    # a bad ref or an empty diff should fail here, not inside an agent. (Borrowed from
    # the /code-review skill, which gets this scoping right.)
    repo=$(git rev-parse --show-toplevel 2>/dev/null) \
      || { note "not a git repository: $(pwd)"; exit 1; }
    git rev-parse --verify --quiet "$base" >/dev/null \
      || { note "base ref does not resolve: $base"; exit 1; }
    # Three-dot compares against the merge-base, so upstream commits you never wrote
    # do not show up as part of your change.
    range="${base}...HEAD"
    if git diff --quiet "$range" 2>/dev/null; then
      note "empty diff for ${range} — nothing to review"; exit 1
    fi
    diffcmd="git -C ${repo} diff ${range}"
    task="${range} in ${repo} — see the diff with: ${diffcmd}"
    cap_is_fresh && fallback "cap cached $(( ($(now)-$(memo_epoch))/3600 ))h ago" "$task"
    run_codex review "Review this diff: ${diffcmd}. Run the tests and cite command plus output for anything you call verified. For every finding give file:line and a concrete failure scenario (specific inputs to a specific wrong outcome). For each new test, name a production change that would make it fail. A clean pass with cited evidence is acceptable; never manufacture findings." "$task"
    ;;
  rescue)
    q="${2:-}"; [ -z "$q" ] && { note "usage: delegate rescue \"<question>\""; exit 1; }
    cap_is_fresh && fallback "cap cached $(( ($(now)-$(memo_epoch))/3600 ))h ago" "$q"
    run_codex rescue "$q" "$q"
    ;;
  status)
    if cap_is_fresh; then
      echo "route: reviewer agent (Codex cap cached $(( ($(now)-$(memo_epoch))/3600 ))h ago, TTL 24h)"
    else
      echo "route: Codex first (no fresh cap on record)"
    fi
    [ -f "$LOG" ] && { echo "--- last 5 runs ---"; tail -5 "$LOG"; }
    ;;
  cap-clear) rm -f "$MEMO"; echo "cap memo cleared; next run will try Codex" ;;
  *) sed -n '4,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
